    "signature": "(self, *, partition_key=None) -> 'None'",
    "docstring": "清除当前网页的 Cookie。\n\nArgs:\n    partition_key: Cookie 分区，默认 None 表示未分区。可传顶层站点网址字符串，或字典\n        {\"top_level_site\": \"https://example.com\", \"has_cross_site_ancestor\": False}；\n        has_cross_site_ancestor 表示是否存在跨站祖先，默认 False。",
    "source": "    def clear_cookies(self, *, partition_key=None) -> None:\n        \"\"\"清除当前网页的 Cookie。\n\n        Args:\n            partition_key: Cookie 分区，默认 None 表示未分区。可传顶层站点网址字符串，或字典\n                {\"top_level_site\": \"https://example.com\", \"has_cross_site_ancestor\": False}；\n                has_cross_site_ancestor 表示是否存在跨站祖先，默认 False。\n        \"\"\"\n        from . import _normalize_cookie_partition_key\n        self._runtime_client().web_page_cookie(\"clear\", page_ref=self._page_ref,\n            partition_key=_normalize_cookie_partition_key(partition_key))\n",
    "file": "sdk\\src\\uiautoma\\web\\browser.py",
    "line": 545
