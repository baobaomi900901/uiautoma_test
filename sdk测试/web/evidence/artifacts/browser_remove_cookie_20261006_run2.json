    "signature": "(self, name: 'str', *, partition_key=None) -> 'None'",
    "docstring": "移除当前网页中指定名称的 Cookie。\n\nArgs:\n    name: 要移除的 Cookie 名称。\n    partition_key: Cookie 分区，默认 None 表示未分区。可传顶层站点网址字符串，或字典\n        {\"top_level_site\": \"https://example.com\", \"has_cross_site_ancestor\": False}；\n        has_cross_site_ancestor 表示是否存在跨站祖先，默认 False。",
    "source": "    def remove_cookie(self, name: str, *, partition_key=None) -> None:\n        \"\"\"移除当前网页中指定名称的 Cookie。\n\n        Args:\n            name: 要移除的 Cookie 名称。\n            partition_key: Cookie 分区，默认 None 表示未分区。可传顶层站点网址字符串，或字典\n                {\"top_level_site\": \"https://example.com\", \"has_cross_site_ancestor\": False}；\n                has_cross_site_ancestor 表示是否存在跨站祖先，默认 False。\n        \"\"\"\n        from . import _normalize_cookie_partition_key\n        self._runtime_client().web_page_cookie(\"delete\", page_ref=self._page_ref, name=name,\n            partition_key=_normalize_cookie_partition_key(partition_key))\n",
    "file": "sdk\\src\\uiautoma\\web\\browser.py",
    "line": 532
  },
