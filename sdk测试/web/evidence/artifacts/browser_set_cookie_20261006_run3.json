    "signature": "(self, *, name=None, value=None, sessionCookie: 'bool' = False, expires: 'float' = 100, domain=None, path=None, httpOnly: 'bool' = False, secure: 'bool' = False) -> 'None'",
    "docstring": "设置当前网页的 Cookie，已存在时覆盖。\n\nArgs:\n    name: Cookie 名称，必须指定。\n    value: Cookie 值，默认 None，设置为空字符串。\n    sessionCookie: 是否设置为会话 Cookie，默认 False；False 为持久 Cookie。\n    expires: 持久 Cookie 的有效期，单位秒，默认 100；会话 Cookie 不使用此参数。\n    domain: Cookie 域名，默认使用网址的域名。\n    path: Cookie 路径，默认使用网址的路径。\n    httpOnly: 是否标记为 HttpOnly，默认 False。\n    secure: 是否标记为 Secure，默认 False。",
    "source": "    def set_cookie(self, *, name=None, value=None, sessionCookie: bool = False, expires: float = 100,\n                   domain=None, path=None, httpOnly: bool = False, secure: bool = False) -> None:\n        \"\"\"设置当前网页的 Cookie，已存在时覆盖。\n\n        Args:\n            name: Cookie 名称，必须指定。\n            value: Cookie 值，默认 None，设置为空字符串。\n            sessionCookie: 是否设置为会话 Cookie，默认 False；False 为持久 Cookie。\n            expires: 持久 Cookie 的有效期，单位秒，默认 100；会话 Cookie 不使用此参数。\n            domain: Cookie 域名，默认使用网址的域名。\n            path: Cookie 路径，默认使用网址的路径。\n            httpOnly: 是否标记为 HttpOnly，默认 False。\n            secure: 是否标记为 Secure，默认 False。\n        \"\"\"\n        self._runtime_client().web_page_cookie(\"set\", page_ref=self._page_ref, name=name, value=\"\" if value is None else value,\n            session_cookie=sessionCookie, expires_seconds=expires, domain=domain, path=path, httpOnly=httpOnly, secure=secure)\n",
    "file": "sdk\\src\\uiautoma\\web\\browser.py",
